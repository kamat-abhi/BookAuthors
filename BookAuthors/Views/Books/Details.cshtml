@model BookAuthors.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div>
    <h4>@Model.Title</h4>
    <hr />
    <h5>Authors</h5>
    @if (Model.Authors.Any())
    {
        <ul>
            @foreach (var author in Model.Authors)
            {
                <li><a asp-controller="Authors" asp-action="Details" asp-route-id="@author.AuthorId">@author.Name</a></li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">No authors assigned.</p>
    }
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.BookId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
