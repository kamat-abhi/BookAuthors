@model BookAuthors.ViewModels.BookFormViewModel

@{
    ViewData["Title"] = "Create Book";
}

<h1>Create Book</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SelectedAuthorIds" class="form-label"></label>
                <select asp-for="SelectedAuthorIds" asp-items="Model.AllAuthors" class="form-select" size="6"></select>
                <div class="form-text">Hold Ctrl (or Cmd) to select multiple authors.</div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-link">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
