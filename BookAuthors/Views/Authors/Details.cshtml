@model BookAuthors.Models.Author

@{
    ViewData["Title"] = "Author Details";
}

<h1>Author Details</h1>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <h5>Books</h5>
    @if (Model.Books.Any())
    {
        <ul>
            @foreach (var book in Model.Books)
            {
                <li><a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">@book.Title</a></li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">No books yet.</p>
    }
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.AuthorId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
